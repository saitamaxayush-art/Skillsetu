# SkillSetu Backend Environment Configuration
# Copy this file to .env and adjust variables as necessary for your environment.

# Server Port (default: 8787)
PORT=8787

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Allowed CORS Origins (comma-separated, default: * in development)
CORS_ORIGIN=http://localhost:5180,http://localhost:5173

# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET=skillsetu_super_secure_jwt_secret_dev_key_change_in_prod

# SQLite Database storage file path
DB_PATH=./skillsetu.db

# Optional: OpenRouteService API key for actual transit isochrone / commute calculations
# If empty or invalid, the transit module falls back gracefully to deterministic haversine & bus network models
OPENROUTESERVICE_API_KEY=

# Optional: Google Gemini or LLM API key for simplifying Hindi/English explanations
# If empty, the deterministic rule-based engine generates explainable reasons directly
GEMINI_API_KEY=
